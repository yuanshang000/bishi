# 应用配置
APP_NAME="College English Assistant"
APP_ENV=development
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/college_english_assistant
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# JWT配置
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API配置
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=30

# Embedding API配置
EMBEDDING_PROVIDER=deepseek
EMBEDDING_API_KEY=sk-your-deepseek-api-key-here
EMBEDDING_MODEL=deepseek-embedding

# ChromaDB配置
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=course_embeddings

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=./logs

# CORS配置
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
